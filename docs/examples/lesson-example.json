      "title": "Try it: does the axis change the story?",
      "html": "<style>.w{display:grid;gap:16px;place-items:center;height:100%}.bars{display:flex;gap:24px;align-items:flex-end;height:60%}.bars div{width:80px;background:#0d7a6f}label{font-size:22px}</style><div class=\"w\"><div class=\"bars\"><div id=\"a\"></div><div id=\"b\"></div></div><label>Axis starts at <input id=\"s\" type=\"range\" min=\"0\" max=\"90\" value=\"0\"> <b id=\"v\">0</b></label></div><script>const A=92,B=96,s=document.getElementById('s');function draw(){const z=+s.value,k=100-z;document.getElementById('a').style.height=((A-z)/k*100)+'%';document.getElementById('b').style.height=((B-z)/k*100)+'%';document.getElementById('v').textContent=z;}s.oninput=draw;draw();</script>",
