# The browser bundle is committed; development dependencies are installed locally.
# Keep editor and OS artefacts out of commits.
.DS_Store
*.log
node_modules/
.history/
.claude/

# Exported decks and games. Remove this line if you want them committed —
# they are plain JSON and diff cleanly. Ignored by default because embedded
# images make them large and they are a snapshot, not source.
data/

# Secrets. The Gemini key goes in .env, which is read by server/server.js at
# boot and must never be committed: this repo is public, and a key in a public
# commit is a key that has to be revoked. .env.example is the template and
# carries no value.
.env
.env.*
!.env.example

# Private attendance and live-session journals
.slideforge/

# Exported bundles: the "everything, as one file" backup from File → Export,
# and the lesson bundles tools/build-ipdv-lesson.js generates. Same reasoning
# as data/ above — they are snapshots whose SVG diagrams are data URIs on
# single lines, and the generator or the app is the readable version.
*.sfbundle.json

# Smoke-test screenshots. The tools in tools/ rewrite these on every run and
# nothing compares them to a baseline, so they are output, not fixtures.
tools/*.png
tools/baselines/diffs/

# Generated by the teaching-PDF and deck-review tooling: contact sheets, page
# renders, slide captures and the exported PDFs themselves. All reproducible
# from the deck, and together they run to tens of megabytes.
.codex-build/
output/
tmp/
