{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "checkJs": true,
    "allowJs": true,
    "noEmit": true,
    "strict": true,
    "noImplicitAny": false,
    "skipLibCheck": true,
    "resolveJsonModule": true
  },
  "include": [
    // Authored source. All of it is checked; keep it that way.
    "src/**/*.js",
    "src/**/*.d.ts",

    // The browser layer is being brought under the checker a file at a time,
    // so the gate only ever covers what is actually clean and `npm test`
    // stays green throughout. Add a file here once `tsc` passes on it.
    //
    // Not listed yet, with their current error counts:
    //   shell 49 · games 102 · manual 141 · live 146 · player 175
    //
    // Never listed: js/model.js is generated by tools/build.mjs from src/,
    // and js/qr.js is vendored.
    "js/bingo.js",
    "js/boss.js",
    "js/bowl.js",
    "js/content-tools.js",
    "js/demo.js",
    "js/emoji-clues.js",
    "js/learner-state.js",
    "js/lessons.js",
    "js/lowstakes.js",
    "js/memory.js",
    "js/race.js",
    "js/adapt.js",
    "js/ask.js",
    "js/customize.js",
    "js/lesson-moments.js",
    "js/playbook.js",
    "js/reports.js",
    "js/teaching.js",
    "js/render.js",
    "js/studio.js",
    "js/editor.js",
    "js/presenter-live.js",
    "js/shell.js"
  ]
}
